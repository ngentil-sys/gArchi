# --- Gemini via Vertex AI (ADK reads these) ---------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Models (Gemini 3.8 Flash is GA on Vertex AI; thinking levels: low | medium | high)
ARCHITECT_MODEL=gemini-3.8-flash
ARCHITECT_THINKING_LEVEL=high
RESEARCHER_MODEL=gemini-3.8-flash
RESEARCHER_THINKING_LEVEL=low

# --- Official icon hosting (Slides API needs public PNG URLs) ----------------
# Mode: gcs | url | none
ICON_HOST=gcs
ICON_BUCKET=your-gcp-project-id-gcp-icons
ICON_PREFIX=icons/
# For a private bucket: service account used to mint V4 signed URLs
# ICON_SIGNER_SA=icon-signer@your-gcp-project-id.iam.gserviceaccount.com
# ICON_URL_TTL_SECONDS=3600
# Alternative static host:
# ICON_HOST=url
# ICON_BASE_URL=https://example.com/gcp-icons

# Optional: share every generated deck with these users (comma-separated)
# SHARE_DECKS_WITH=someone@google.com

# --- Terraform generation ----------------------------------------------------
# Where generated projects are written (default: <repo>/output)
# OUTPUT_DIR=/path/to/output
# terraform binary for fmt/validate (default: first `terraform` or `tofu` on PATH)
# TERRAFORM_BIN=/usr/local/bin/terraform
